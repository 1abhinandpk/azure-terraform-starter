terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Subscription ID is read from the ARM_SUBSCRIPTION_ID environment variable.
# Auth uses your Azure CLI login (az login).
provider "azurerm" {
  features {}
}
